@@ -0,0 +1,490 @@
+{
+  "description": "Prompt set for spec_bench.py. The matrix set has 8 original prompts per category and the long set has 6 prompts that elicit long answers; the client wraps these in the ChatML template with no system message and sends them to /completion. The tool set has 8 requests that should produce one tool call and the agent set has 8 subagent turns (the shared agent_system prompt, a task, one prior tool call and its result); both go to /v1/chat/completions with the tools below and the server's own template.",
+  "sets": {
+    "matrix": {"n_predict": 512},
+    "long": {"n_predict": 2000},
+    "tool": {"n_predict": 512},
+    "agent": {"n_predict": 512}
+  },
+  "tools": [
+    {"type": "function", "function": {"name": "get_weather", "description": "Get the current weather for a city.", "parameters": {"type": "object", "properties": {"city": {"type": "string", "description": "City name, for example Lisbon"}, "country": {"type": "string", "description": "Two letter country code, optional"}, "units": {"type": "string", "enum": ["celsius", "fahrenheit"], "description": "Temperature unit, default celsius"}}, "required": ["city"]}}},
+    {"type": "function", "function": {"name": "search_docs", "description": "Search the internal documentation and return matching pages with a short excerpt.", "parameters": {"type": "object", "properties": {"query": {"type": "string", "description": "Free text search query"}, "space": {"type": "string", "enum": ["engineering", "billing", "support", "all"], "description": "Documentation space to search, default all"}, "limit": {"type": "integer", "minimum": 1, "maximum": 20, "description": "Maximum number of results, default 5"}}, "required": ["query"]}}},
+    {"type": "function", "function": {"name": "run_sql", "description": "Run a read-only SQL query against the analytics database and return the rows.", "parameters": {"type": "object", "properties": {"query": {"type": "string", "description": "A single SELECT statement"}, "database": {"type": "string", "enum": ["analytics", "billing"], "description": "Database to query, default analytics"}, "row_limit": {"type": "integer", "minimum": 1, "maximum": 1000, "description": "Maximum rows to return, default 100"}}, "required": ["query"]}}},
+    {"type": "function", "function": {"name": "create_ticket", "description": "Create a ticket in the issue tracker and return its id.", "parameters": {"type": "object", "properties": {"title": {"type": "string", "description": "Short ticket title"}, "body": {"type": "string", "description": "Ticket description in markdown"}, "priority": {"type": "string", "enum": ["low", "medium", "high", "urgent"]}, "team": {"type": "string", "enum": ["web", "mobile", "backend", "data", "support"], "description": "Team that owns the ticket"}, "labels": {"type": "array", "items": {"type": "string"}, "description": "Optional labels"}}, "required": ["title", "body", "priority"]}}}
+  ],
+  "agent_tools": [
